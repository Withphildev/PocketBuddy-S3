PORT=5810
HOST=0.0.0.0
BUDDY_TOKEN=replace-with-a-long-random-token

# Dark Tower's existing Ollama service.
OLLAMA_URL=http://192.168.0.172:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_KEEP_ALIVE=30m
BUDDY_NAME=Ember
BUDDY_OWNER=Phil

# Optional OpenAI-compatible speech endpoints. Leave blank to run text-only.
STT_URL=http://buddy-stt:8000
STT_API_KEY=
STT_MODEL=Systran/faster-distil-whisper-small.en
TTS_URL=http://buddy-tts:8880
TTS_API_KEY=
TTS_MODEL=kokoro
TTS_VOICE=af_sky

MAX_AUDIO_BYTES=262144
AUDIO_TTL_MS=300000
